            object EditRenTemplate: TComboBox
              Left = 27
              Height = 23
              Hint = 'Enter a filename template containing placeholders for special values.'#13#10'This template will be expanded for each resampled image. Insert the'#13#10'$(SIZE) placeholder to enable multiple sizes in a common folder.'
