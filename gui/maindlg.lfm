          object ComboBoxSizeName: TComboBox
            Left = 354
            Height = 23
            Hint = 'Some presentations require named sizes especially for distinguish thumbnail'#13#10'sizes from large ones. If you plan to create presentations its a good idea to'#13#10'size names. Usually the name THUMBNAIL is used for small images.'#13#10#13#10'Take a look on your presentations requirements, which size names are required.'#13#10#13#10'You can use the size itself as a name of the size but this could be unconvenient'#13#10'if you decide to change the thumbnails size. In this case the presentations'#13#10'keywords may have to be changed.'
            Top = 64
            Width = 111
            Anchors = [akTop, akRight]
            ItemHeight = 15
            ItemIndex = 0
            Items.Strings = (
              '<auto>'
              '<size>'
              '<empty>'
              'THUMBNAIL'
              'DOCUMENT'
              'SCREEN'
            )
            TabOrder = 3
            Text = '<auto>'
          end
